# Copy to .env and fill in. Never commit .env.

# PayPal SANDBOX app credentials: developer.paypal.com/dashboard -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# AI extraction (default provider: Anthropic). Server-side only.
ANTHROPIC_API_KEY=
AI_MODEL=

# Server
PORT=3001
# Where the React app is served from (CORS allowlist and PayPal return/cancel redirects)
CLIENT_URL=http://localhost:5173
# Public base URL of THIS server as PayPal will redirect to it (use an https tunnel if PayPal rejects localhost)
SERVER_URL=http://localhost:3001

# SQLite file via Prisma
DATABASE_URL=file:./prisma/dev.db

# Only for `npm run spike:payee -w server` (sandbox money-flow experiment, see docs/decisions/0001-settlement-money-flow.md)
SPIKE_PAYEE_EMAIL=
SPIKE_RECIPIENT_EMAIL=
